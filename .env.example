APP_NAME=BlogIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ENABLE_QUEUE_WORKER=true
ENABLE_SCHEDULER=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=blogia_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_SEARCH_CONSOLE_BASE_URL=https://www.googleapis.com/webmasters/v3

GOOGLE_TRENDS_BIGQUERY_PROJECT_ID=
GOOGLE_TRENDS_BIGQUERY_CLIENT_EMAIL=
GOOGLE_TRENDS_BIGQUERY_PRIVATE_KEY=
GOOGLE_TRENDS_BIGQUERY_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_TRENDS_BIGQUERY_BASE_URL=https://bigquery.googleapis.com/bigquery/v2
GOOGLE_TRENDS_BIGQUERY_DATASET=bigquery-public-data.google_trends
GOOGLE_TRENDS_BIGQUERY_LOCATION=US
GOOGLE_TRENDS_BIGQUERY_TOP_TERMS_TABLE=international_top_terms
GOOGLE_TRENDS_BIGQUERY_RISING_TERMS_TABLE=international_top_rising_terms
